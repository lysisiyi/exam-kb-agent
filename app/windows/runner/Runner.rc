/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_APP_ICON            ICON                    "resources\\app_icon.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Version
//

#if defined(FLUTTER_VERSION_MAJOR) && defined(FLUTTER_VERSION_MINOR) && defined(FLUTTER_VERSION_PATCH) && defined(FLUTTER_VERSION_BUILD)
#define VERSION_AS_NUMBER FLUTTER_VERSION_MAJOR,FLUTTER_VERSION_MINOR,FLUTTER_VERSION_PATCH,FLUTTER_VERSION_BUILD
#else
#define VERSION_AS_NUMBER 1,0,0,0
#endif

#if defined(FLUTTER_VERSION)
#define VERSION_AS_STRING FLUTTER_VERSION
#else
#define VERSION_AS_STRING "1.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION_AS_NUMBER
 PRODUCTVERSION VERSION_AS_NUMBER
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            // ⚠️ CompanyName + ProductName 决定**应用数据目录**：
            //    path_provider_windows 用 exe 版本信息拼出
            //    %APPDATA%\<CompanyName>\<ProductName>，也就是现在的
            //    `%APPDATA%\com.kaoyan\kaoyan_math_agent`。
            //    改这两个值等于把用户的题库换到另一个目录 —— 文件不会消失，
            //    但 App 看不见了，所以**要改就必须同时写一次目录迁移**。
            //    这里刻意保留 flutter create 生成的名字。
            VALUE "CompanyName", "com.kaoyan" "\0"
            // 这两个只是显示用（任务管理器 / 属性页），不参与目录拼接。
            // LegalCopyright 必须与仓库根的 LICENSE（MIT）一致 ——
            // 早先写的是 "All rights reserved."，那与 MIT 直接矛盾。
            VALUE "FileDescription", "exam-kb-agent" "\0"
            VALUE "FileVersion", VERSION_AS_STRING "\0"
            VALUE "InternalName", "kaoyan_math_agent" "\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 lysisiyi. MIT License." "\0"
            VALUE "OriginalFilename", "kaoyan_math_agent.exe" "\0"
            VALUE "ProductName", "kaoyan_math_agent" "\0"
            VALUE "ProductVersion", VERSION_AS_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END

